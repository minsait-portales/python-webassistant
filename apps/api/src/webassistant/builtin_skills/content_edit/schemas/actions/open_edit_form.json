{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_title"
  ],
  "properties": {
    "content_title": {
      "type": "string",
      "maxLength": 300
    },
    "content_type": {
      "type": "string",
      "maxLength": 128
    },
    "content_id": {
      "type": [
        "string",
        "integer"
      ]
    }
  }
}
