{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "range",
    "focus"
  ],
  "properties": {
    "range": {
      "enum": [
        "month",
        "quarter",
        "year",
        "all",
        "custom"
      ]
    },
    "focus": {
      "enum": [
        "revenue",
        "categories",
        "products",
        "stores",
        "orders",
        "overview"
      ]
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    }
  }
}
