{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_id"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "maxLength": 128
    },
    "variation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    }
  }
}
