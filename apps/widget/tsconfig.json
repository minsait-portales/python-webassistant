{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "@webassistant/sdk": [
        "../../packages/sdk-js/src/index.ts"
      ]
    },
    "useUnknownInCatchVariables": true
  },
  "include": [
    "src",
    "tests",
    "e2e/**/*.ts"
  ]
}
