{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webassistant.ai/schemas/theme.v1.schema.json",
  "title": "Tokens de tema del widget v1",
  "description": "Solo se aceptan tokens limitados y validados; no se acepta CSS arbitrario. El backend comprueba contraste WCAG AA.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accent": { "$ref": "#/$defs/color" },
    "on_accent": { "$ref": "#/$defs/color" },
    "text": { "$ref": "#/$defs/color" },
    "surface": { "$ref": "#/$defs/color" },
    "muted_surface": { "$ref": "#/$defs/color" },
    "border": { "$ref": "#/$defs/color" },
    "highlight": { "$ref": "#/$defs/color" },
    "font_family": { "enum": ["system", "forfuture", "serif", "inherit"] },
    "radius": { "type": "integer", "minimum": 0, "maximum": 24 },
    "position": { "enum": ["left", "right"] },
    "launcher_label": { "type": "string", "maxLength": 40 },
    "logo_url": { "type": "string", "pattern": "^(https://|/)[^\\s]*$", "maxLength": 2048 },
    "chat_width": { "type": "integer", "minimum": 320, "maximum": 640 },
    "z_index": { "type": "integer", "minimum": 1, "maximum": 2147483000 }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
