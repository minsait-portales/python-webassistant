{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webassistant.ai/schemas/presentations/event_selection.v1.schema.json",
  "title": "Presentación event_selection@1 (selección de productos agrupada para un evento)",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories"],
  "properties": {
    "intro": { "$ref": "_common.v1.schema.json#/$defs/text" },
    "event_name": { "$ref": "_common.v1.schema.json#/$defs/short_text" },
    "people": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "vegetarian_people": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "dietary_restrictions": { "type": "array", "items": { "$ref": "_common.v1.schema.json#/$defs/short_text" }, "maxItems": 20 },
    "budget": { "type": "string", "maxLength": 80 },
    "notes": { "$ref": "_common.v1.schema.json#/$defs/text" },
    "categories": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "items"],
        "properties": {
          "name": { "$ref": "_common.v1.schema.json#/$defs/short_text" },
          "description": { "$ref": "_common.v1.schema.json#/$defs/text" },
          "items": { "type": "array", "items": { "$ref": "_common.v1.schema.json#/$defs/product_item" }, "maxItems": 20 }
        }
      }
    },
    "total_products": { "type": "integer", "minimum": 0 },
    "total_amount": { "type": "string", "maxLength": 60 },
    "outro": { "$ref": "_common.v1.schema.json#/$defs/text" }
  }
}
