# Configuración de WebAssistant para Docker Compose. Copia este fichero a .env y ajústalo.
# Sin .env, `docker compose up` arranca en modo desarrollo con la demo y el proveedor simulado.
# Todas las variables de la aplicación usan el prefijo WEBASSISTANT_ (ver docs/configuracion.md).

# --- General ------------------------------------------------------------------------------
# development | test | staging | production (staging/production exigen secretos y servicios reales)
WEBASSISTANT_ENVIRONMENT=development
# URL pública con la que los navegadores llegan a la API (se usa en enlaces, CORS de la demo y tokens)
WEBASSISTANT_PUBLIC_BASE_URL=http://localhost:8000
WEBASSISTANT_PORT=8000
WEBASSISTANT_LOG_LEVEL=INFO

# --- Secretos (obligatorios en staging/producción) -----------------------------------------
# Al menos 32 caracteres aleatorios: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBASSISTANT_JWT_SECRET=
# Secretos anteriores (separados por comas) aceptados durante una rotación
WEBASSISTANT_JWT_PREVIOUS_SECRETS=
# Clave Fernet para los payloads técnicos cifrados: docker compose run --rm api webassistant generate-key
WEBASSISTANT_ENCRYPTION_KEY=
# Token Bearer exigido por /metrics (vacío = sin autenticación, solo en redes internas)
WEBASSISTANT_METRICS_TOKEN=

# --- Bases de datos -----------------------------------------------------------------------
POSTGRES_PASSWORD=postgres-dev-password
WEBASSISTANT_DB_NAME=webassistant
WEBASSISTANT_DB_USER=webassistant
WEBASSISTANT_DB_PASSWORD=webassistant-dev-password
# Clave de Qdrant (obligatoria con compose.prod.yaml)
QDRANT_API_KEY=

# --- Modelos ------------------------------------------------------------------------------
# simulated (sin coste, determinista) | openai
WEBASSISTANT_DEFAULT_PROVIDER=simulated
WEBASSISTANT_DEFAULT_CHAT_MODEL=gpt-6-luna
WEBASSISTANT_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# Endpoint compatible OpenAI (Azure OpenAI, pasarela corporativa...). Vacío = api.openai.com
OPENAI_BASE_URL=

# --- Demo y arranque ----------------------------------------------------------------------
# Crea el tenant demo, el site site_demo, el assistant catalogo, sus documentos y la web /demo/
WEBASSISTANT_DEMO_ENABLED=true
# Orígenes adicionales permitidos para el site de demo (separados por comas)
WEBASSISTANT_DEMO_ORIGINS=
# Administrador inicial de plataforma (se crea al arrancar si no existe). En desarrollo, sin
# valor, la demo crea admin@demo.local / Demo-Admin-2026.
WEBASSISTANT_BOOTSTRAP_ADMIN_EMAIL=
WEBASSISTANT_BOOTSTRAP_ADMIN_PASSWORD=
WEBASSISTANT_DEMO_CLIENT_SECRET=

# --- Red ----------------------------------------------------------------------------------
# Proxies de confianza para X-Forwarded-For (CIDR separados por comas)
WEBASSISTANT_TRUSTED_PROXIES=

# --- Observabilidad (perfil observability) ------------------------------------------------
WEBASSISTANT_OTEL_ENABLED=false
WEBASSISTANT_OTEL_EXPORTER_ENDPOINT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-dev-password

# --- Build tras un proxy corporativo con inspección TLS -------------------------------------
# Ruta a la CA del proxy (se pasa como secreto de build, no queda en la imagen)
EXTRA_CA_CERTS=
