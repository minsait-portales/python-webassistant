{
  "name": "webassistant-monorepo",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "WebAssistant AI: widget, consola de administración y SDK TypeScript.",
  "workspaces": [
    "packages/sdk-js",
    "apps/widget",
    "apps/admin"
  ],
  "scripts": {
    "build": "npm run build -w @webassistant/sdk && npm run build -w @webassistant/widget && npm run build -w @webassistant/admin",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . && prettier --check \"**/*.{ts,mjs,json,css,md}\" --ignore-path .prettierignore",
    "format": "prettier --write \"**/*.{ts,mjs,json,css}\" --ignore-path .prettierignore",
    "test": "npm run test --workspaces --if-present && npm run test:drupal",
    "test:drupal": "vitest run -c integraciones/drupal/tests/js/vitest.config.mjs",
    "e2e": "npm run e2e -w @webassistant/widget && npm run e2e -w @webassistant/admin",
    "generate:sdk": "npm run generate -w @webassistant/sdk"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
