msgstr "Secreto del cliente API"

msgid "Absolute URL used to build the canonical URL of documents, for example %example. Required when cron or Drush run without the public host name. Leave empty to use the current request."
msgstr "URL absoluta con la que se construye la URL canónica de los documentos, por ejemplo %example. Obligatoria si cron o Drush se ejecutan sin el nombre de host público. Déjala vacía para usar la petición actual."

msgid "Access"
msgstr "Acceso"

msgid "Add several products to cart"
msgstr "Añadir varios productos al carrito"

msgid "Add source"
msgstr "Añadir fuente"

