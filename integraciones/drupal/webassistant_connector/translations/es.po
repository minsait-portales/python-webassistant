msgid "Grants the analytics:read scope and the analytics.sales_report host action, which also requires \"Use the commerce administration pages\"."
msgstr "Concede el scope analytics:read y la host action analytics.sales_report, que además requiere \"Usar las páginas de administración de Commerce\"."

msgid "Grants the cart:read and cart:write scopes and the cart.get, cart.add, cart.add_many, cart.update, cart.remove and cart.checkout host actions on the own shopping cart. Drupal Commerce access checks still apply."
msgstr "Concede los scopes cart:read y cart:write y las host actions cart.get, cart.add, cart.add_many, cart.update, cart.remove y cart.checkout sobre el propio carrito. Se siguen aplicando las comprobaciones de acceso de Drupal Commerce."

msgid "Grants the content:write scope and the content.create and content.edit host actions. Drupal access checks still apply."
msgstr "Concede el scope content:write y las host actions content.create y content.edit. Se siguen aplicando las comprobaciones de acceso de Drupal."

msgid "Grants the profile:read scope and the user.profile host action."
msgstr "Concede el scope profile:read y la host action user.profile."

