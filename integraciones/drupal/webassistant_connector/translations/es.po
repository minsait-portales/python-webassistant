msgstr "Contenido principal"

msgid "Make sure cron runs (or run \"drush queue:run webassistant_connector_dispatch\") and check the platform on the <a href=\":url\">status page</a>."
msgstr "Comprueba que cron se ejecuta (o ejecuta \"drush queue:run webassistant_connector_dispatch\") y revisa la plataforma en la <a href=\":url\">página de estado</a>."

msgid "Map a field with the \"Access\" role: role references, or texts such as public, authenticated, role:editor or group:12. Items with an empty value are not indexed."
msgstr "Asigna a un campo el rol \"Acceso\": referencias a roles o textos como public, authenticated, role:editor o group:12. Los elementos con el valor vacío no se indexan."

