<?php

/**
 * @file
 * Install, update and uninstall functions for the WebAssistant connector.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function webassistant_connector_schema(): array {
  // State-based outbox (design section 9.1, amendment A1): one row per
  // source, entity type, entity ID and langcode. Every capture merges into
  // the row and increments "seq"; a worker claims the row with a lease and
  // only finishes it when "seq" still equals the claimed value.
  $schema['webassistant_connector_outbox'] = [
    'description' => 'Synchronization events (state-based transactional outbox) for the WebAssistant platform.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'event_id' => [
        'type' => 'varchar_ascii',
        'length' => 36,
        'not null' => TRUE,
        'default' => '',
        'description' => 'UUID of the row (stable across captures).',
      ],
      'operation' => [
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'upsert',
        'description' => 'Operation hint (upsert or delete); the worker decides from the current state.',
      ],
      'source' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'ID of the webassistant_source config entity, or a pseudo-source starting with "_".',
      ],
      'entity_type' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Entity type ID.',
      ],
      'entity_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Entity ID.',
      ],
      'entity_uuid' => [
        'type' => 'varchar_ascii',
        'length' => 36,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Entity UUID.',
      ],
      'langcode' => [
        'type' => 'varchar_ascii',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Language code of the translation.',
      ],
      'revision_id' => [
        'type' => 'varchar_ascii',
        'length' => 32,
        'not null' => FALSE,
        'description' => 'Revision ID at capture time (informative).',
      ],
      'status' => [
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'pending',
        'description' => 'Status: pending, processing, done, failed or dead.',
      ],
      'seq' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Incremented on every capture.',
      ],
      'claimed_seq' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Value of seq when the row was claimed.',
      ],
      'claim_token' => [
        'type' => 'varchar_ascii',
        'length' => 36,
        'not null' => FALSE,
        'description' => 'Token of the worker that claimed the row.',
      ],
      'lease_until' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp until which the claim is valid (0: no lease).',
      ],
      'attempts' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Number of delivery attempts.',
      ],
      'next_attempt' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp of the next attempt.',
      ],
      'last_error' => [
        'type' => 'varchar',
        'length' => 1024,
        'not null' => FALSE,
        'description' => 'Last error, without secrets.',
      ],
      'correlation_id' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'X-Request-Id of the last platform request.',
      ],
      'remote' => [
        'type' => 'text',
        'size' => 'normal',
        'not null' => FALSE,
        'description' => 'Summarized remote result (JSON).',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp of the first capture not delivered yet.',
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp of the last change.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'event_id' => ['event_id'],
      'entity_key' => ['source', 'entity_type', 'entity_id', 'langcode'],
    ],
    'indexes' => [
      'status_next_attempt' => ['status', 'next_attempt'],
      'status_lease' => ['status', 'lease_until'],
      'claim_token' => ['claim_token'],
      'status_changed' => ['status', 'changed'],
    ],
  ];

  $schema['webassistant_connector_document'] = [
    'description' => 'Documents sent to the WebAssistant platform per entity and translation.',
    'fields' => [
      'knowledge_base' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Remote knowledge base key.',
      ],
      'remote_id' => [
        'type' => 'varchar_ascii',
        'length' => 256,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Remote source_id.',
      ],
      'source' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'ID of the webassistant_source config entity.',
      ],
      'entity_type' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Entity type ID.',
      ],
      'entity_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Entity ID.',
      ],
      'langcode' => [
        'type' => 'varchar_ascii',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Language code of the translation.',
      ],
      'attachment' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'UUID of the attached file, if the document is an original.',
      ],
      'version' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Version sent.',
      ],
      'content_hash' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'SHA-256 of the content sent.',
      ],
      'payload_hash' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'SHA-256 of the document sent, without volatile reference fields (amendment A8).',
      ],
      'acl' => [
        'type' => 'text',
        'size' => 'normal',
        'not null' => FALSE,
        'description' => 'ACL sent (JSON list).',
      ],
      'remote_status' => [
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Last remote status (sending, queued, ready, failed, stale...).',
      ],
      'synced' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp of the last synchronization.',
      ],
      'reconciled' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Start timestamp of the last reconciliation that found the document remotely.',
      ],
    ],
    'primary key' => ['knowledge_base', 'remote_id'],
    'indexes' => [
      'entity_key' => ['source', 'entity_type', 'entity_id', 'langcode'],
      'attachment' => ['attachment'],
      'source_remote' => ['source', 'remote_id'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 *
 * Gives the installation its own remote source_id prefix (amendment A10):
 * "drupal-" plus the first 8 hexadecimal characters of the site UUID, so two
 * Drupal sites sharing a knowledge base never overwrite each other.
 */
function webassistant_connector_install(bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }
  $config = \Drupal::configFactory()->getEditable('webassistant_connector.settings');
  if ($config->isNew()) {
    return;
  }
  $uuid = strtolower((string) \Drupal::config('system.site')->get('uuid'));
  $hex = substr((string) preg_replace('/[^0-9a-f]/', '', $uuid), 0, 8);
  if (strlen($hex) === 8) {
    $config->set('sync.source_id_prefix', 'drupal-' . $hex)->save();
  }
}

/**
 * Implements hook_uninstall().
 */
function webassistant_connector_uninstall(bool $is_syncing): void {
  // State entries owned by the module (all prefixed with the module name).
  $state_names = array_filter(
    array_keys(\Drupal::keyValue('state')->getAll()),
    static fn (string $name): bool => str_starts_with($name, 'webassistant_connector.'),
  );
  if ($state_names !== []) {
    \Drupal::state()->deleteMultiple(array_values($state_names));
  }

  // Key/value collections (idempotency of host actions and module data).
  foreach (['webassistant_connector', 'webassistant_connector.host_action'] as $collection) {
    \Drupal::keyValue($collection)->deleteAll();
    \Drupal::keyValueExpirable($collection)->deleteAll();
  }

  // Queues.
  foreach (['webassistant_connector_dispatch', 'webassistant_connector_reconcile', 'webassistant_connector_index'] as $queue) {
    \Drupal::queue($queue)->deleteQueue();
  }
}
